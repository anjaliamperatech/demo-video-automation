BASE_URL=http://localhost:3000
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me
API_TOKEN=replace-me

# Needed only for scenes that give narration instead of exact steps.
# Ask whoever manages your Azure OpenAI resource for these values.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
# The name of your Azure deployment, e.g. gpt-4o or gpt-5-nano (not the raw model name).
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: auto-generate narration audio with text-to-speech instead of
# recording it by hand. If set, any scene with narration but no recorded
# clip gets one synthesized automatically during the run (cached to
# stories/<story>/narration/<scene-id>.mp3 so it's only generated once).
# TTS often lives on its own Azure resource (separate from the chat
# deployment above) — set these if so. If left unset, TTS falls back to the
# AZURE_OPENAI_ENDPOINT/API_KEY/API_VERSION above.
TTS_AZURE_OPENAI_ENDPOINT=
TTS_AZURE_OPENAI_API_KEY=
TTS_AZURE_OPENAI_API_VERSION=
# The name of your Azure TTS deployment, e.g. tts-1 or gpt-4o-mini-tts.
TTS_AZURE_OPENAI_DEPLOYMENT=
# One of: alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse.
# Defaults to "nova" (clear/warm/energetic) if left unset — better suited to
# product demo narration than the flatter default "alloy".
TTS_AZURE_OPENAI_VOICE=nova
# Only honored by steerable models like gpt-4o-mini-tts (ignored by plain
# tts-1). Free-text delivery direction; defaults to an upbeat, confident
# "product demo narrator" style if left unset.
TTS_AZURE_OPENAI_INSTRUCTIONS=
