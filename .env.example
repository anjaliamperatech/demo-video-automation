AZURE_OPENAI_API_KEY=replace-me
# The name of your Azure deployment, e.g. gpt-4o or gpt-5-nano (not the raw model name).
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
